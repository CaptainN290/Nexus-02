<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Nexus Bot Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="{{ url_for('static', filename='style.css') }}" rel="stylesheet">
</head>
<body class="bg-dark text-light text-center">
  <nav class="navbar navbar-dark bg-black">
    <div class="container">
      <a class="navbar-brand" href="/">Nexus Bot</a>
      <div>
        <a class="btn btn-outline-light btn-sm" href="/commands">Commands</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <h1 class="mb-4">Dashboard</h1>

    <div class="row g-3 justify-content-center">
      <div class="col-md-3">
        <div class="card bg-secondary text-light">
          <div class="card-body">
            <h6>Servers</h6>
            <p class="display-6">{{ stats.guilds }}</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-secondary text-light">
          <div class="card-body">
            <h6>Users</h6>
            <p class="display-6">{{ stats.users }}</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-secondary text-light">
          <div class="card-body">
            <h6>Latency</h6>
            <p class="display-6">{{ stats.latency }}</p>
          </div>
        </div>
      </div>
    </div>

    <p class="text-muted mt-4">Uptime: {{ stats.uptime }} • Version: {{ stats.version }}</p>
  </main>

  <footer class="text-center py-4 text-muted">Made by <strong>@captainn29</strong></footer>
</body>
</html>
